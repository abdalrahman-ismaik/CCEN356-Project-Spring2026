*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore

# Generated logs, data, captures, and charts
logs/
*.log
data/
charts/
captures/
*.csv
*.pcap

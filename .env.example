# CCEN356 public configuration example
# Copy values into your shell or a local .env file if your tooling loads it.
# Do not commit real passwords, private keys, packet captures, or generated logs.

# Lab endpoints
CCEN356_SERVER_HOST=192.165.20.79
CCEN356_HTTP_URL=http://192.165.20.79
CCEN356_HTTPS_URL=https://192.165.20.79

# Router SSH automation
CCEN356_ROUTER_HOST=192.165.10.37
CCEN356_ROUTER_USERNAME=admin
CCEN356_ROUTER_PASSWORD=change-me
CCEN356_ROUTER_SECRET=change-me

# Packet capture
CCEN356_CAPTURE_CLIENT_IPS=192.165.10.92,192.165.10.79
CCEN356_CAPTURE_TIMEOUT_SEC=60

# Benchmarking
CCEN356_REQUESTS_PER_PROTOCOL=50
CCEN356_BENCHMARK_TIMEOUT_SEC=10
CCEN356_BENCHMARK_INTERVAL_SEC=0.1
CCEN356_VERIFY_TLS=false

# Flask HTTP/HTTPS servers
CCEN356_HTTP_HOST=0.0.0.0
CCEN356_HTTP_PORT=80
CCEN356_HTTPS_HOST=0.0.0.0
CCEN356_HTTPS_PORT=443
CCEN356_TLS_CERT_FILE=server/cert.pem
CCEN356_TLS_KEY_FILE=server/key.pem

# Live dashboard
CCEN356_DASHBOARD_HOST=0.0.0.0
CCEN356_DASHBOARD_PORT=5000
CCEN356_POLL_INTERVAL_SEC=0.5
CCEN356_REQUEST_TIMEOUT_SEC=1.5
CCEN356_DASHBOARD_MAX_SAMPLES=240

# QoS demo knobs used by the Flask servers and dashboard probes
CCEN356_QOS_MODE_HEADER=X-CCEN356-QOS-MODE
CCEN356_QOS_MODE_VALUE=on
CCEN356_QOS_HTTP_DELAY_MS=75
CCEN356_QOS_HTTP_DELAY_JITTER_MS=10
CCEN356_HTTPS_BASE_DELAY_MS=0
CCEN356_QOS_HTTPS_RELIEF_MS=0
CCEN356_QOS_HTTPS_DELAY_MS=0
